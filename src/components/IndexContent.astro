---
import type { ImageMetadata } from "astro";

interface Article {
  id: string;
  body?: string;
  data: {
    title: string;
    description?: string;
    "card-bg"?: string;
  };
}

interface Section {
  label: string;
  directory: string;
  indexLabel?: string;
}

interface Group {
  section: Section;
  articles: Article[];
}

interface CourseCard {
  href: string;
  eyebrow: string;
  title: string;
  description: string;
  imageSrc?: string;
}

const { groups } = Astro.props as { groups: Group[] };

const markdownFiles = import.meta.glob<string>("../content/docs/**/*.md", {
  eager: true,
  import: "default",
  query: "?raw",
});

const imageFiles = import.meta.glob<ImageMetadata>(
  "../**/*.{avif,gif,jpeg,jpg,png,webp}",
  {
    eager: true,
    import: "default",
  },
);

function normalizePath(path: string) {
  const output: string[] = [];
  for (const segment of path.split("/")) {
    if (!segment || segment === ".") continue;
    if (segment === ".." && output.at(-1) !== "..") output.pop();
    else output.push(segment);
  }
  return path.startsWith("../") ? `../${output.join("/")}` : output.join("/");
}

function readFrontmatterValue(source: string, key: string) {
  const match = source.match(/^---\n([\s\S]*?)\n---/);
  if (!match) return undefined;
  const value = match[1].match(new RegExp(`^${key}:\\s*["']?(.+?)["']?\\s*$`, "m"));
  return value?.[1]?.trim();
}

function readFirstImage(source: string) {
  const markdownImage = source.match(/!\[[^\]]*\]\(([^)\s]+)(?:\s+"[^"]*")?\)/);
  if (markdownImage?.[1]) return markdownImage[1];

  const htmlImage = source.match(/<img\s+[^>]*src=["']([^"']+)["']/i);
  return htmlImage?.[1];
}

function resolveImage(docKey: string, imagePath?: string) {
  if (!imagePath) return undefined;
  if (/^(?:https?:)?\/\//.test(imagePath) || imagePath.startsWith("/")) return imagePath;

  const docDir = docKey.slice(0, docKey.lastIndexOf("/"));
  const imageKey = normalizePath(`${docDir}/${imagePath}`);
  const image = imageFiles[imageKey];
  return image?.src;
}

function compareArticle(a: Article, b: Article) {
  return a.id.localeCompare(b.id, undefined, { numeric: true });
}

function sectionTitle(section: Section) {
  return section.indexLabel ?? section.label;
}

function articleLabel(section: Section, article: Article) {
  const lecture = article.id.match(/lec(\d+)/)?.[1];
  if (lecture) return `Lecture ${lecture}`;

  const tutorial = article.id.match(/p(\d+)t(\d+)/);
  if (tutorial) return `Part ${tutorial[1]} Tutorial ${tutorial[2]}`;

  return section.label;
}

function sourcePathFromArticle(section: Section, article: Article) {
  const segments = article.id.split("/");
  segments[0] = section.directory;
  return segments.join("/");
}

function toCard(section: Section, article: Article): CourseCard {
  const docKey = `../content/docs/${sourcePathFromArticle(section, article)}.md`;
  const rawSource = markdownFiles[docKey] ?? "";
  const cardBg = article.data["card-bg"] ?? readFrontmatterValue(rawSource, "card-bg");
  const imagePath = cardBg ?? readFirstImage(article.body ?? rawSource);

  return {
    href: `../${article.id}/`,
    eyebrow: articleLabel(section, article),
    title: article.data.title,
    description: article.data.description || "No description yet.",
    imageSrc: resolveImage(docKey, imagePath),
  };
}
---

<div class="course-index">
  {
    groups.map(({ section, articles }) => (
      <section class="course-part" aria-labelledby={`${section.directory}-title`}>
        <h2 id={`${section.directory}-title`}>{sectionTitle(section)}</h2>
        <div class="course-card-grid">
          {articles.sort(compareArticle).map((article) => {
            const card = toCard(section, article);
            return (
              <a class="course-card" href={card.href}>
                <div class="course-card__media" aria-hidden="true">
                  {card.imageSrc ? (
                    <img src={card.imageSrc} alt="" loading="lazy" decoding="async" />
                  ) : (
                    <span class="course-card__fallback" />
                  )}
                </div>
                <div class="course-card__body">
                  <p class="course-card__eyebrow">{card.eyebrow}</p>
                  <h3>{card.title}</h3>
                  <p class="course-card__description">{card.description}</p>
                </div>
              </a>
            );
          })}
        </div>
      </section>
    ))
  }
</div>

<style>
  .course-index {
    display: grid;
    gap: clamp(1.75rem, 3vw, 2.6rem);
    margin-top: 0.35rem;
  }

  .course-part {
    min-width: 0;
  }

  .course-part h2 {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin: 0 0 0.85rem;
    border-top: 0;
    padding-top: 0;
    color: var(--dc-c-dark);
    font-family: var(--dc-font-serif);
    font-size: clamp(1.45rem, 2.4vw, 2rem);
    line-height: 1.18;
    letter-spacing: -0.025em;
  }

  .course-part h2::before {
    content: "";
    flex: 0 0 auto;
    border: 3px solid rgb(217 119 87 / 0.16);
    border-radius: 999px;
    width: 0.72rem;
    height: 0.72rem;
    background: var(--dc-c-orange-soft);
    box-shadow: inset 0 0 0 3px rgb(217 119 87 / 0.22);
  }

  .course-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14.5rem), 1fr));
    gap: clamp(0.9rem, 1.6vw, 1.2rem);
    align-items: stretch;
  }

  .course-card {
    position: relative;
    display: block;
    height: 9.9rem;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--dc-glass-border);
    border-radius: 1.05rem;
    background: var(--dc-c-bg-elv);
    color: inherit;
    text-decoration: none !important;
    box-shadow:
      0 1px 2px rgb(20 20 19 / 0.05),
      0 18px 48px rgb(20 20 19 / 0.09);
    transform: translateZ(0);
    transition:
      border-color 0.28s ease,
      box-shadow 0.28s ease,
      transform 0.28s ease;
  }

  .course-card:hover,
  .course-card:focus-visible {
    border-color: var(--dc-c-focus-ring);
    box-shadow:
      0 2px 6px rgb(20 20 19 / 0.08),
      0 24px 64px rgb(20 20 19 / 0.14);
    transform: translateY(-4px);
  }

  .course-card:focus-visible {
    outline: 2px solid var(--dc-c-orange);
    outline-offset: 4px;
  }

  .course-card__media {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 0%, rgb(217 119 87 / 0.18), transparent 42%),
      var(--dc-c-bg-alt);
  }

  .course-card__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgb(20 20 19 / 0.2));
    pointer-events: none;
  }

  .course-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease;
  }

  .course-card:hover .course-card__media img,
  .course-card:focus-visible .course-card__media img {
    transform: scale(1.035);
  }

  .course-card__fallback {
    display: block;
    width: 100%;
    height: 100%;
    background:
      linear-gradient(135deg, rgb(217 119 87 / 0.22), transparent 42%),
      linear-gradient(315deg, rgb(20 20 19 / 0.08), transparent 45%),
      var(--dc-c-bg-alt);
  }

  .course-card__body {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    height: 3.45rem;
    overflow: hidden;
    border-top: 1px solid var(--dc-glass-border);
    padding: 0.44rem 0.72rem 0.5rem;
    background: rgb(255 255 255 / 0.74);
    backdrop-filter: blur(18px) saturate(1.25);
    -webkit-backdrop-filter: blur(18px) saturate(1.25);
    transition:
      height 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      padding 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      background-color 0.34s ease,
      border-color 0.34s ease;
  }

  .course-card:hover .course-card__body,
  .course-card:focus-visible .course-card__body {
    justify-content: flex-end;
    height: 100%;
    padding: 0.72rem 0.78rem 0.82rem;
    background: rgb(255 255 255 / 0.82);
    border-color: transparent;
  }

  .course-index .course-card__eyebrow {
    margin: 0 0 0.22rem;
    color: var(--dc-c-orange-strong);
    font-family: var(--dc-font-ui);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .course-index .course-card .course-card__body h3 {
    display: -webkit-box;
    margin: 0;
    overflow: hidden;
    color: var(--dc-c-dark);
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    font-family: var(--dc-font-serif);
    font-size: clamp(0.96rem, 1vw, 1.08rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.012em;
    transition: color 0.28s ease;
  }

  .course-card:hover .course-card__body h3,
  .course-card:focus-visible .course-card__body h3 {
    -webkit-line-clamp: 2;
  }

  .course-index .course-card__description {
    display: block;
    margin: 0.38rem 0 0;
    max-height: 0;
    overflow: hidden;
    color: var(--dc-c-muted);
    opacity: 0;
    transform: translateY(0.35rem);
    font-size: 0.8rem;
    font-weight: 500;
    line-height: 1.42;
    transition:
      max-height 0.34s cubic-bezier(0.22, 1, 0.36, 1),
      opacity 0.22s ease,
      transform 0.28s ease;
  }

  .course-card:hover .course-card__description,
  .course-card:focus-visible .course-card__description {
    max-height: 4.4rem;
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0.06s, 0.08s, 0.08s;
  }

  :root[data-theme="dark"] .course-card {
    background: var(--dc-c-bg-elv);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.26),
      0 18px 52px rgb(0 0 0 / 0.38);
  }

  :root[data-theme="dark"] .course-card:hover,
  :root[data-theme="dark"] .course-card:focus-visible {
    box-shadow:
      0 2px 8px rgb(0 0 0 / 0.34),
      0 24px 68px rgb(0 0 0 / 0.5);
  }

  :root[data-theme="dark"] .course-card__body {
    background: rgb(20 20 19 / 0.7);
  }

  :root[data-theme="dark"] .course-card:hover .course-card__body,
  :root[data-theme="dark"] .course-card:focus-visible .course-card__body {
    background: rgb(20 20 19 / 0.82);
  }

  :root[data-theme="dark"] .course-card__media::after {
    background: linear-gradient(180deg, transparent 38%, rgb(0 0 0 / 0.46));
  }

  @media (max-width: 36rem) {
    .course-card {
      height: 10.4rem;
    }

    .course-card__body {
      height: 3.65rem;
    }

    .course-card__body h3 {
      font-size: 1.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .course-card,
    .course-card__media img {
      transition: none;
    }

    .course-card:hover,
    .course-card:focus-visible,
    .course-card:hover .course-card__media img,
    .course-card:focus-visible .course-card__media img {
      transform: none;
    }
  }
</style>
