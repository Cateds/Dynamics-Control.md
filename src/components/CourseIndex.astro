---
import { getCollection } from "astro:content";
import IndexContent from "./IndexContent.astro";
import { courseDirectoryToRouteSegment, courseSections } from "../../course.config";

const docs = await getCollection("docs");
const groups = courseSections
  .filter((section) => section.showInIndex)
  .map((section) => {
    const routeSegment = courseDirectoryToRouteSegment(section.directory);
    const articles = docs.filter((doc) => {
      const sectionSegment = doc.id.split("/")[0];
      return sectionSegment === routeSegment || sectionSegment === section.directory;
    });

    return { section, articles };
  })
  .filter(({ articles }) => articles.length > 0);
---

<div class="course-index-shell">
  <IndexContent groups={groups} />
</div>

<style>
  @layer starlight.core {
    :global(html:has(.course-index-shell)) {
      --sl-mobile-toc-height: 0rem;
    }

    :global(.page:has(.course-index-shell) .content-panel .sl-container) {
      max-width: min(100%, 78rem);
    }

    :global(.page:has(.course-index-shell) .page-title-block) {
      margin-inline: 0;
      text-align: start;
    }

    @media (min-width: 50rem) {
      :global(html:not([data-has-toc]):has(.course-index-shell)) {
        --__toc-width: var(--sl-sidebar-width);
      }
    }

    :global(.page:has(.course-index-shell) .right-sidebar-container),
    :global(.page:has(.course-index-shell) mobile-starlight-toc) {
      display: none !important;
    }

    @media (min-width: 72rem) {
      :global(.page:has(.course-index-shell) .main-pane) {
        order: 0 !important;
        width: 100% !important;
      }
    }
  }
</style>
